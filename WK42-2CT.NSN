0001/** New Subprogram WK42-2CT.
0002/**
0003/** :author tzu
0004DEFINE DATA PARAMETER
00051 #PERSONNEL-ID (A8)
0006LOCAL
00071 EMPLOYEES-DATA VIEW OF EMPLOYEES
0008  2 PERSONEL-ID (A8) 
0009  2 COUNTRY (A3)
00101 #INDEX (N2)
00111 #COUNTRY (A3/1:6)
00121 #PROGRAM(A8)
0013END-DEFINE
0014#PROGRAM := *PROGRAM
0015FIND EMPLOYEES-DATA WITH PERSONEL-ID = #PERSONNEL-ID
0016  #COUNTRY(#INDEX) := COUNTRY
0017  DISPLAY *ISN
0018    EMPLOYEES-DATA.COUNTRY
0019END-FIND
0020END
