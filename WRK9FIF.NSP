0004/* TODO workshop 09 find languages for employees
0005
0006DEFINE DATA LOCAL 
0007
00081 EMPLOYEES-DATA VIEW OF EMPLOYEES
0009  2 PERSONEL-ID (A8) /* CNNNNNNN
0010  2 NAME (A20) /* SURNAME / FAMILY NAME
0011  2 COUNTRY (A3) /* COUNTRY CODE
0012  2 C*LANG
0013  2 LANG (A3/1:5) /* LANGUAGES SPOKEN /** reduce the aray
0014END-DEFINE
0015
0016FORMAT LS=200
0017
0018* R. READ EMPLOYEES-DATA BY EMPLOYEES-DATA.PERSONEL-ID
0019 F1. FIND EMPLOYEES-DATA WITH EMPLOYEES-DATA.CITY = 'DARMSTADT'
0020    DISPLAY
0021      *ISN
0022      'PERS /ID'EMPLOYEES-DATA.PERSONEL-ID
0023      'Name'EMPLOYEES-DATA.NAME (AL=10)
0024      'CTRY'EMPLOYEES-DATA.COUNTRY
0025      '1ST /LANG'EMPLOYEES-DATA.LANG (1)
0026      '2ND /LANG'EMPLOYEES-DATA.LANG (2)
0027      '3RD /LANG' EMPLOYEES-DATA.LANG (3)
0028      '4TH /LANG'EMPLOYEES-DATA.LANG (4)
0029      '5TH /LANG'EMPLOYEES-DATA.LANG (5)
0030      'N# OF /LANG'EMPLOYEES-DATA.C*LANG
0031        AT END OF DATA
0032    WRITE ' :'
0033      WRITE 'THIS IS THE END OF THE RECORD...'
0034  END-ENDDATA
0035  END-FIND
0036* END-READ
0037END
