0001/** New Subprogram WK41-VEH.
0002/**
0003/** :author tzu
0004DEFINE DATA 
0005PARAMETER
00061 #PERSONNEL-ID (A8)
00071 #NAME(A20)
0008LOCAL
00091 VIHICLES-DATA VIEW OF VIHICLES
0010  2 REG-NUM (A15)
0011  2 CHASIS-NUM (B4)
0012  2 PERSONEL-ID (A8) /* NC
0013  2 CAR-DETAILS
0014    3 MAKE (A20)
0015    3 MODEL (A20)
0016    3 COLOUR (A10)
0017  2 YEAR (N4.0)
0018  2 DATE-ACQ (N8.0)
00191 #PROGRAM (A8)
00201 EMPLOYEES-DATA VIEW OF EMPLOYEES
0021  2 NAME (A20) 
0022  2 PERSONEL-ID (A8)
00231 #VEHICLE-COUNT (N3)
00241 #TOTAL-VE (N3)
0025END-DEFINE
0026#PROGRAM :=*PROGRAM
0027
0028FIND VIHICLES-DATA WITH PERSONEL-ID = #PERSONNEL-ID
0029  ADD 1 TO #VEHICLE-COUNT
0030  MOVE *NUMBER TO  #TOTAL-VE 
0031  EMPLOYEES-DATA.PERSONEL-ID := #PERSONNEL-ID
0032  INPUT USING MAP "WRK41-VH"
0033END-FIND
0034IF #VEHICLE-COUNT = 0
0035  WRITE 'Personal ID:'#PERSONNEL-ID / 
0036  'Name:' #NAME /
0037    'EMPLOYEE DO NOT HAVE A VEHICLE'
0038END-IF
0039END
