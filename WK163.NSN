0005DEFINE DATA
0006PARAMETER
00071 #PERSONNEL-ID (A8)
00081 #INDEX1 (N3)
0009/**
00101 #PERSONEL-ID (A8/1:5) 
00111 #MAKE (A20/1:5)
00121 #MODEL (A20/1:5)
00131 #COLOUR (A10/1:5)
00141 #YEAR (A4/1:5)
0015
0016LOCAL
00171 VIHICLES-DATA VIEW OF VIHICLES
0018  2 PERSONEL-ID (A8)
0019  2 MAKE (A20)
0020  2 MODEL (A20)
0021  2 COLOUR (A10)
0022  2 YEAR (N4.0)
0023
0024END-DEFINE
0025FIND VIHICLES-DATA WITH PERSONEL-ID = #PERSONNEL-ID
0026  ADD 1 TO #INDEX1
0027/**MOVE THE VARIABLE USING PARSING THEIR INDEXES
0028  MOVE PERSONEL-ID TO #PERSONEL-ID(#INDEX1)
0029  MOVE MAKE    TO #MAKE(#INDEX1)
0030  MOVE MODEL   TO #MODEL(#INDEX1)
0031  MOVE COLOUR  TO #COLOUR(#INDEX1)
0032  MOVE YEAR    TO #YEAR(#INDEX1)
0033
0034END-FIND
0035INPUT USING MAP "WK16VH"
0036END
