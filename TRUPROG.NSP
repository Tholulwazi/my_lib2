0005DEFINE DATA
0006LOCAL 
0007* NAMES
00081 #EMP-1 (A9) INIT <'INNOCENT'>
00091 #EMP-2 (A9) INIT   <'NOCENT'>
00101 #EMP-3 (A9)  INIT  <'NOCENT'>
00111 #SEARCH (A3) INIT <'CEN'>
0012END-DEFINE
0013* IF STATEMENTS
0014
0015IF #EMP-1 = #EMP-2 OR #EMP-3 = #EMP-1
0016  WRITE #EMP-1 'IS EQUAL TO ' #EMP-2 'OR' #EMP-3 'IS EQUAL TO ' #EMP-1
0017ELSE
0018WRITE #EMP-1 'IS NOT EQUAL TO ' #EMP-2 'OR' #EMP-3 'IS NOT EQUAL TO ' #EMP-1
0019END-IF
0020
0021IF #EMP-1 = SCAN #SEARCH
0022  WRITE 'CEN' ' IS CONTAINED IN'#EMP-1
0023END-IF
0024IF #EMP-1 = MASK(..'N')
0025  WRITE 'N' 'IS CONTAINED IN ' #EMP-1
0026END-IF
0027END
