0001/** New Program WRK8FIND.
0002/*** >Natural Source Header 000000
0003* :Mode S
0004* :CP
0005* <Natural Source Header
0006/** :author tzu
0007/* TODO Ask for input of name and show
0008/** the results using a phonetic descriptor
0009DEFINE DATA LOCAL
00101 EMPLOYEES-DATA VIEW OF EMPLOYEES
0011  2 PERSONEL-ID (A8) /* CNNNNNNN
0012  2 NAME (A20) /* SURNAME / FAMILY NAME
0013  2 GENDER (A1)
0014  2 COUNTRY (A3) /* COUNTRY CODE
0015* 2 PHONETIC-NAME (A20) /* PHONETIC LAST NAME
00161 #EXIT (A1)
00171 #NAME (A20)
0018END-DEFINE
0019* FORMAT LS = 50 /** Nomal line size should be 80
0020SET CONTROL 'mt'
0021
0022REPEAT 
0023
0024  INPUT 'ENTER NAME : ' #NAME (AD=M) / #EXIT 'TO EXIT PRESS "Y" '
0025  IF #EXIT = 'Y'
0026    ESCAPE BOTTOM
0027  END-IF
0028
0029  FIND EMPLOYEES-DATA WITH PHONETIC-NAME = #NAME
0030    DISPLAY
0031      *ISN
0032      PERSONEL-ID
0033      NAME
0034      GENDER
0035      COUNTRY
0036
0037  END-FIND
0038
0039
0040END-REPEAT
0041END
