0013/** :author tzu
0014/* TODO Enter your code here
0015DEFINE DATA
0016LOCAL
00171 VIHICLES-DATA VIEW OF VIHICLES
0018  2 REG-NUM (A15)
0019  2 PERSONEL-ID (A8) /* NC
0020  2 MAKE (A20)
0021  2 MODEL (A20)
0022  2 COLOUR (A10)
0023  2 YEAR (N4.0)
0024  /**
00251 #INDEX (N3)
00261 #REG-NUM (A15/1:16)
00271 #PERSONEL-ID (A8/1:16) /* NC
00281 #MAKE (A10/1:16)
00291 #MODEL (A10/1:16)
00301 #MAKE-MODEL (A22/1:16)
00311 #COLOUR (A10/1:16)
00321 #YEAR (N4.0/1:16)
0033END-DEFINE
0034/**SETTING PF KEYS
0035SET KEY
0036  PF3 NAMED 'EXIT'
0037/**
0038READ VIHICLES-DATA BY PERSONEL-ID
0039/**
0040  ADD 1 TO #INDEX
0041/**MOVE THE VARIABLE USING PARSING THEIR INDEXES
0042  MOVE PERSONEL-ID TO #PERSONEL-ID (#INDEX)
0043  MOVE REG-NUM TO #REG-NUM(#INDEX)
0044  COMPRESS MAKE '-'   TO #MAKE(#INDEX) 
0045  MOVE MODEL   TO #MODEL(#INDEX)
0046  MOVE COLOUR  TO #COLOUR(#INDEX)
0047  MOVE YEAR    TO #YEAR(#INDEX)
0048/**
0049 COMPRESS #MAKE(#INDEX)  #MODEL(#INDEX) INTO #MAKE-MODEL(#INDEX)
0050 LEAVING SPACE
0051 /**
0052  IF #INDEX = 16
0053    INPUT USING MAP "WK16BH2"
0054    IF *PF-KEY = 'PF3'
0055      ESCAPE BOTTOM
0056      RESET #INDEX
0057    END-IF
0058  END-IF
0059END-READ
0060/**
0061IF #INDEX < 16
0062  RESET   #PERSONEL-ID(#INDEX +1:16)
0063  RESET #COLOUR (#INDEX +1:16)
0064  RESET #MAKE(#INDEX +1:16)
0065  RESET #REG-NUM(#INDEX +1:16)
0066  RESET #YEAR(#INDEX +1:16)
0067  RESET #MODEL(#INDEX +1:16)
0068  RESET #MAKE-MODEL(#INDEX +1:16)
0069END-IF
0070END
