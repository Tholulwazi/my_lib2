0001/** New Program IFEMPLOY.
0002/**
0003/** :author tzu
0004
0005DEFINE DATA 
0006LOCAL
00071 START-HABOUR (A32) INIT <'BARCELONA'>
00081 DEST-HABOUR (A32) INIT <'ATHENS'>
0009END-DEFINE
0010*
0011IF START-HABOUR = 'BARCELONA' 
0012IF DEST-HABOUR =  'ROME'
0013START-HABOUR := 'VALENCIA'
0014DEST-HABOUR := 'ATHENS'
0015ELSE
0016START-HABOUR := 'PALMA'
0017END-IF
0018END-IF
0019WRITE '=' START-HABOUR /
0020  '=' DEST-HABOUR
0021END
