0001DEFINE DATA
0002
0003LOCAL
0004
00051 NUMVALUE (N5)
0006
00071 #MESSAGE (A40)
0008
0009END-DEFINE
0010
0011**
0012
0013REPEAT
0014
0015  ADD 1 TO NUMVALUE
0016
0017*
0018
0019  DECIDE ON FIRST VALUE OF NUMVALUE
0020
0021    VALUE 1 : 3
0022
0023      MOVE 'VALUE IS 1, 2 OR 3' TO #MESSAGE
0024
0025    VALUE 5
0026
0027      MOVE 'VALUE IS 5' TO #MESSAGE
0028
0029    VALUE 7, 8, 10
0030
0031      MOVE 'VALUE IS 7, 8 OR 10' TO #MESSAGE
0032
0033    VALUE 13, 15 : 18
0034
0035      MOVE 'VALUE IS 13 OR IN RANGE 15 TO 18' TO #MESSAGE
0036
0037    NONE
0038
0039      MOVE 'INVALID VALUE' TO #MESSAGE
0040
0041  END-DECIDE
0042
0043*
0044
0045  WRITE NUMVALUE #MESSAGE
0046
0047  UNTIL NUMVALUE = 20
0048
0049END-REPEAT
0050
0051* 
0052END
