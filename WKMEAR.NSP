0001/** New Program WKMEAR.
0002/**
0003/** :author tzu
0004/* Move variable by group
0005DEFINE DATA 
0006LOCAL
0007/**group 1
00081 #CALCULATOR-A
0009  2 #VAR-1 (N5) INIT <50>
0010  2 #VAR-2 (N5) INIT <200>
0011  2 #SOLUTION (N9) INIT <45898>
0012  2 #SOLUTION-2 (A9) INIT <'CAL A'>
0013    /** group 2
00141 #CALCULATOR-B
0015  2 #VAR-1 (N5) INIT <550>
0016  2 #VAR-2 (N5) INIT <2080>
0017  2 #SOLUTION-2 (N9) INIT <5000>
0018  2 #SOLUTION (A9) INIT <'CALC B'>
0019END-DEFINE
0020/**Work solution out using 'write' Statement
0021* MOVE #VAR-1  TO #CALCULATOR-A.#SOLUTION
0022* #SOLUTION := #SOLUTION + #VAR-2
0023* WRITE '=' #SOLUTION
0024/**USING "MOVE BY NAME" STATEMENT FOR THES GROUPS
0025MOVE BY NAME  #CALCULATOR-A TO #CALCULATOR-A
0026WRITE 'CALC A' / #CALCULATOR-A
0027/**MOVING VALUES OF A GROUP BY POSITION 'MOVE BY POSITION'STATEMENTS
0028MOVE BY POSITION #CALCULATOR-A TO #CALCULATOR-B
0029WRITE 'CALC B' / #CALCULATOR-B
0030END
