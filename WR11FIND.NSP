0011/* TODO Search all employees from sales dEPARTMENT
0012DEFINE DATA LOCAL
00131 EMPLOYEES-DATA VIEW OF EMPLOYEES
0014  2 PERSONEL-ID (A8) /* CNNNNNNN
0015  2 FIRST-NAME (A20) /* FIRST / CHRISTIAN NAME
0016  2 NAME (A20) /* SURNAME/FAMILY NAME
0017  2 CITY (A20)
0018  2 INCOME (1:3) /* ANNUAL INCOMES
0019    3 CURR-CODE (A3) /* CURRENCY OF INCOME
0020    3 SALARY (P9.0) /* ANNUAL SALARY
0021    3 BONUS (P9.0/1:3) /* BONUS PER YEAR
0022  2 DEPT (A6) /* MAINDEPT. CODE DDDD
0023END-DEFINE
0024*
0025FORMAT LS= 150
0026PS =20
0027WRITE TITLE LEFT /** hEATING OF THE PAGE
0028  *PROGRAM (AD=I)
0029* 
0030*  
0031R. READ EMPLOYEES-DATA BY EMPLOYEES-DATA.DEPARTMENT
0032    FROM   'SALE' TO 'SALE'
0033  DISPLAY
0034    EMPLOYEES-DATA.PERSONEL-ID (AD=I)
0035    EMPLOYEES-DATA.NAME (AL=10 AD=I) 
0036    EMPLOYEES-DATA.DEPT (AD=I AL=6)
0037    EMPLOYEES-DATA.SALARY (1)(AD=I)
0038    EMPLOYEES-DATA.BONUS(1,*) (AD=I)
