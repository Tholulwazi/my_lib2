0001/** New Program WR12FIND.
0002/**
0003/** :author tzu
0004/* 
0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES-DATA VIEW OF EMPLOYEES
0008  2 PERSONEL-ID (A8) /* CNNNNNNN
0009  2 FIRST-NAME (A20) /* FIRST / CHRISTIAN NAME
0010  2 NAME (A20) /* SURNAME / FAMILY NAME
0011  2 ADDRESS-LINE (A20/1:1) /* ALL ADDRESS LINES
0012  2 CITY (A20) /* MAIN TOWN/CITY
0013  2 POST-CODE (A10) /* POSTAL ADDRESS CODE
0014  2 COUNTRY (A3) /* COUNTRY CODE
0015
0016END-DEFINE
0017
0018FORMAT LS=200
0019
0020DEFINE WORK FILE 1
0021  'C:\TRAININGS\NAMES1.TXT'
0022
0023R1. READ EMPLOYEES-DATA BY EMPLOYEES-DATA.PERSONEL-ID 
0024    FROM '1000000' TO '1999999'
0025
0026
0027  WRITE WORK 1 VARIABLE 
0028    EMPLOYEES-DATA.PERSONEL-ID EMPLOYEES-DATA.NAME 
0029    EMPLOYEES-DATA.FIRST-NAME EMPLOYEES-DATA.ADDRESS-LINE (1)
0030    EMPLOYEES-DATA.CITY EMPLOYEES-DATA.COUNTRY
0031
0032
0033*
0034  AT END OF DATA
0035  WRITE '='
0036      COUNT(R1.)(EMPLOYEES-DATA.COUNTRY) (AD=I)
0037    WRITE 'RECORDS WERE PRINTED TO THE WORKFILE'
0038  END-ENDDATA
0039END-READ
0040CLOSE WORK FILE 1 
0041*
0042
0043
0044END
