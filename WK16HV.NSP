0005DEFINE DATA
0006LOCAL
00071 VIHICLES-DATA VIEW OF VIHICLES
0008  2 REG-NUM (A15)
0009  2 PERSONEL-ID (A8) /* NC
0010  2 MAKE (A20)
0011  2 MODEL (A20)
0012  2 COLOUR (A10)
0013  2 YEAR (N4.0)
0014/**
00151 #INDEX (N3)
00161 #REG-NUM (A15/1:16)
00171 #PERSONEL-ID (A8/1:16) 
00181 #MAKE (A10/1:16)
00191 #MODEL (A10/1:16)
00201 #COLOUR (A10/1:16)
00211 #YEAR (N4.0/1:16)
0022/**PARAMETERS
00231 #SELECT (A3/1:16)
00241 #INDEX1 (N2)
00251 #PERSONNEL-ID (A8)
0026END-DEFINE
0027/**SETTING PF KEYS
0028SET KEY
0029  PF3 NAMED 'EXIT'
0030/**
0031REPEAT
0032READ VIHICLES-DATA BY PERSONEL-ID
0033/**
0034  ADD 1 TO #INDEX
0035/**MOVE THE VARIABLE USING PARSING THEIR INDEXES
0036  MOVE PERSONEL-ID TO #PERSONEL-ID(#INDEX)
0037  MOVE REG-NUM TO #REG-NUM(#INDEX)
0038  MOVE MAKE    TO #MAKE(#INDEX)
0039  MOVE MODEL   TO #MODEL(#INDEX)
0040  MOVE COLOUR  TO #COLOUR(#INDEX)
0041  MOVE YEAR    TO #YEAR(#INDEX)
0042/**
0043  IF #INDEX = 16
0044    INPUT USING MAP "WK163MAP"
0045    IF *PF-KEY = 'PF3'
0046      ESCAPE BOTTOM
0047      RESET #INDEX
0048    END-IF
0049  END-IF
0050  /**
0051    FOR #INDEX1  1 TO 16
0052    IF #SELECT(#INDEX1) = 'V'
0053 CALLNAT "WK163" #PERSONNEL-ID #INDEX1 #PERSONEL-ID(1:5) #MAKE(1:5) #MODEL(1:5) #COLOUR(1:5) #YEAR(1:5)
0054* CALLNAT "WK163" #PERSONNEL-ID 
0055END-IF
0056END-FOR
0057  
0058END-READ
0059/**
0060IF #INDEX < 16 
0061  RESET #PERSONEL-ID(#INDEX +1:16)
0062  RESET #COLOUR (#INDEX +1:16)
0063  RESET #MAKE(#INDEX +1:16)
0064  RESET #REG-NUM(#INDEX +1:16)
0065  RESET #YEAR(#INDEX +1:16)
0066  RESET #MODEL(#INDEX +1:16)
0067END-IF
0068END-REPEAT
0069END
