0005
0006DEFINE DATA LOCAL 
0007
00081 EMPLOYEES-DATA VIEW OF EMPLOYEES
0009  2 PERSONEL-ID (A8) /* CNNNNNNN
0010  2 NAME (A20) /* SURNAME / FAMILY NAME
0011  2 COUNTRY (A3) /* COUNTRY CODE
0012  2 C*LANG
