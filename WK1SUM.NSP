0037DEFINE WORK FILE 1
0038  'C:\Trainings\TOTALS.txt'
0039
0040READ EMPLOYEES-DATA 
0041
0042/**MALE & FEMALE
0043  DECIDE ON FIRST VALUE OF GENDER
0044    VALUE 'M' ADD 1 TO #TOTAL-M
0045    VALUE 'F' ADD 1 TO #TOTAL-F
0046    VALUE ' ' ADD 1 TO #TOTAL-B
0047    NONE  ADD 1 TO #TOTAL-N
0048  END-DECIDE
0049  /** PERSONNEL ID
0050  DECIDE FOR EVERY CONDITION 
0051    WHEN PERSONEL-ID   <= '19999999'
0052    ADD 1 TO #TOTAL-PSI1
0053        WHEN PERSONEL-ID   <= '29999999'
0054    ADD 1 TO #TOTAL-PSI2
0055        WHEN PERSONEL-ID   <= '39999999'
0056    ADD 1 TO #TOTAL-PSI3
0057        WHEN PERSONEL-ID   <= '49999999'
0058    ADD 1 TO #TOTAL-PSI4
0059        WHEN PERSONEL-ID   <= '59999999'
0060    ADD 1 TO #TOTAL-PSI4
0061        WHEN PERSONEL-ID   <= '69999999'
0062    ADD 1 TO #TOTAL-PSI5
0063        WHEN PERSONEL-ID   <= '79999999'
0064    ADD 1 TO #TOTAL-PSI6
0065    WHEN NONE IGNORE 
0066END-DECIDE
0067*   DECIDE ON EVERY VALUE OF PERSONEL-ID
0068*     VALUE '19999999' ADD 1 TO #TOTAL-PSI1
0069*     VALUE '29999999' ADD 1 TO #TOTAL-PSI2
0070*     VALUE '39999999' ADD 1 TO #TOTAL-PSI3
0071*     VALUE '49999999' ADD 1 TO #TOTAL-PSI4
0072*     VALUE '59999999' ADD 1 TO #TOTAL-PSI5
0073*     VALUE '69999999' ADD 1 TO #TOTAL-PSI6
0074*     NONE IGNORE 
0075*   END-DECIDE
0076  /**SALARY
0077  DECIDE ON EVERY VALUE OF SALARY
0078    VALUE 0:4999 ADD 1 TO SALARY1
0079    VALUE 5000:9999 ADD 1 TO SALARY2
0080    VALUE 10000:14999 ADD 1 TO SALARY3
0081    VALUE 15000:19999 ADD 1 TO SALARY4
0082    VALUE 20000:199999 ADD 1 TO SALARY5
0083    NONE IGNORE
0084  END-DECIDE
0085  
0086  /**
0087*   DECIDE FOR EVERY CONDITION 
0088*     WHEN CONDITION STATEMENTS1 
0089*     WHEN NONE STATEMENTS2 
0090* END-DECIDE
0091* *MARITAL STATUS
0092  DECIDE ON EVERY VALUE OF MAR-STAT
0093    VALUE 'S' ADD 1 TO #MAR-STATS
0094    VALUE 'D' ADD 1 TO #MAR-STATD
0095    VALUE 'M' ADD 1 TO #MAR-STATM
0096    VALUE 'W' ADD 1 TO #MAR-STATW
0097    VALUE ' ' ADD 1 TO #MAR-STATB
0098    NONE ADD 1 TO #MAR-STATN
0099  END-DECIDE
0100  END-READ
0101/**GENDER
