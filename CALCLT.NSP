0001/** New Program CALCLT.
0002/**
0003/** :author tzu
0004/* TODO Calculator
0005DEFINE DATA LOCAL
00061 #VALUE-1 (N4.4)
00071 #VALUE-2 (N4.4)
00081 #RESULT (N4.4)
00091 #OPERATOR (A1)
0010*
0011END-DEFINE
0012*
0013FORMAT LS =150
0014SET CONTROL 'mt'
0015REPEAT 
0016*
0017  INPUT 'This is an addition Operator ' /
0018    #VALUE-1 (AD=MI)/
0019   '#Operator' #OPERATOR (AD=MI)' +,-,*,/ '  /
0020    #VALUE-2 (AD=MI)//
0021    #RESULT (AD=OI) 
0022* 
0023PERFORM WRK16SBR #VALUE-1 #VALUE-2 #RESULT #OPERATOR
0024  IF #OPERATOR = '#'
0025    ESCAPE BOTTOM
0026  END-IF
0027*
0028  IF  #OPERATOR EQ  '*' OR
0029      #OPERATOR EQ '+' OR
0030      #OPERATOR EQ '/' OR
0031      #OPERATOR EQ '-'
0032      
0033    IGNORE
0034  ELSE
0035    REINPUT 'Invalid operator'
0036      MARK *#OPERATOR
0037  END-IF
0038  
0039*   CALLNAT "CALCL08" #VALUE-1 #VALUE-2 #RESULT #OPERATOR
0040WRITE 'EXECUTION TIME :' *CPU-TIME 'Seconds'
0041END-REPEAT
0042
0043
0044END
