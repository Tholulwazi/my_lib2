0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DATA VIEW OF EMPLOYEES
0007  2 PERSONEL-ID (A8)
0008  2 C*LANG  /* LANGUAGES SPOKEN
0009  2 LANG (A3/1:40) /* LANGUAGES SPOKEN
00101  #LANG (A3/1:40)
00111 #INDEX1 (N5)
00121 #NUMBER (A1)
00131 REDEFINE #NUMBER
0014  2 #NUMBER-1 (N1)
00151 #INDEX2 (N5)
00161 #COUNT-LANG (N5)
00171 #COUNT-LANG2 (N5)
0018END-DEFINE
0019DEFINE WORK FILE 1 
0020  'C:\Trainings\Languages Spoken in Employees DDM.txt'
0021DEFINE WORK FILE 2 
0022  'C:\Trainings\Languages Spoken in GERMANY .txt'
0023DEFINE WORK FILE 3 'C:\Trainings\Languages Spoken in USA .txt'
0024DEFINE WORK FILE 4 'C:\Trainings\Languages Spoken in UK .txt'
0025DEFINE WORK FILE 5 'C:\Trainings\Languages Spoken in DNK .txt'
0026DEFINE WORK FILE 6 'C:\Trainings\Languages Spoken in FRA .txt'
0027DEFINE WORK FILE 7 'C:\Trainings\Languages Spoken in ESP .txt'
0028
0029READ EMPLOYEES-DATA BY PERSONEL-ID
0030
0031  MOVE SUBSTRING (PERSONEL-ID,1,1) TO #NUMBER
0032
0033  FOR #INDEX1 = 1 TO C*LANG
0034
0035    FOR #INDEX2 = 1 TO 40
0036
0037      IF #LANG(#INDEX2) = ' '
0038
0039        ADD 1 TO #COUNT-LANG
0040
0041        MOVE LANG(#INDEX1) TO #LANG(#INDEX2) /**CHECK
0042        ESCAPE BOTTOM
0043
0044      ELSE
0045
0046        IF LANG(#INDEX1) = #LANG(#INDEX2)
0047          ADD 1 TO #COUNT-LANG2
0048          ESCAPE BOTTOM
0049
0050        END-IF
0051
0052      END-IF
0053
0054    END-FOR
0055
0056  END-FOR
0057
0058
0059END-READ
0060  DECIDE ON FIRST VALUE OF #NUMBER-1
0061    VALUE 1 WRITE WORK FILE 2 #LANG(#INDEX2)
0062    VALUE 2 WRITE WORK FILE 3 #LANG(#INDEX2)
0063    VALUE 3 WRITE WORK FILE 4 #LANG(#INDEX2)
0064    VALUE 4 WRITE WORK FILE 5 #LANG(#INDEX2)
0065    VALUE 5 WRITE WORK FILE 6 #LANG(#INDEX2)
0066    VALUE 6 WRITE WORK FILE 7 #LANG(#INDEX2)
0067    NONE
0068      IGNORE
0069  END-DECIDE
0070FOR #INDEX2 = 1 TO 40
0071
0072  WRITE WORK FILE 1 #LANG(#INDEX2)
0073
0074END-FOR 
0075CLOSE WORK FILE 1
0076CLOSE WORK FILE 2
0077
0078WRITE 'Number of Languages written: '#COUNT-LANG
0079WRITE 'Number of Languages not written: '#COUNT-LANG2
0080END
