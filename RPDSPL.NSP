0001* DEFINE DATA
0002* LOCAL
0003* 
0004* 1 NUMVALUE (N5)
0005* 
0006* 1 #MESSAGE (A40)
0007* 
0008* END-DEFINE
0009* **
0010* INPUT 'ENTER ANY INTEGER FROM 0 - 20' NUMVALUE
0011* 
0012*   DECIDE ON FIRST VALUE OF NUMVALUE
0013* 
0014*     VALUE 1 : 3
0015* 
0016*       MOVE 'VALUE IS 1, 2 OR 3' TO #MESSAGE
0017* 
0018*     VALUE 5
0019* 
0020*       MOVE 'VALUE IS 5' TO #MESSAGE
0021* 
0022*     VALUE 7, 8, 10
0023* 
0024*       MOVE 'VALUE IS 7, 8 OR 10' TO #MESSAGE
0025* 
0026*     VALUE 13, 15 : 18
0027* 
0028*       MOVE 'VALUE IS 13 OR IN RANGE 15 TO 18' TO #MESSAGE
0029* 
0030*     NONE
0031* 
0032*       MOVE 'INVALID VALUE' TO #MESSAGE
0033* 
0034*   END-DECIDE
0035* 
0036* *
0037* 
0038*   WRITE NUMVALUE #MESSAGE
0039* * 
0040* IF NUMVALUE = 99
0041* STOP
0042* END-IF
0043* 
0044* END
0045
0046DEFINE DATA
0047LOCAL
00481 CRUISE-ID  (A8) INIT <'12345678'>
00491 YACHT-NAME  (A20)INIT <'ENTER NAME'>
00501 SCAN-VALUE (A3)  CONST <'$'>
00511 START-HABOUR (A20) INIT <'RHODOS'>
0052END-DEFINE
0053
0054INPUT (AD=M) MARK *YACHT-NAME
0055/ 'ENYER NEW YACHT-NAME-NAME CANNOT CONTAIN  $'
0056/ CRUISE-ID / YACHT-NAME /START-HABOUR
0057
0058DECIDE FOR FIRST CONDITION 
0059    WHEN YACHT-NAME = ' ' 
0060    STOP
0061    WHEN  YACHT-NAME = SCAN SCAN-VALUE
0062    CRUISE-ID :='99999999' 
0063    REINPUT FULL 'WRONG YACHT NAME'
0064    WHEN NONE
0065    CRUISE-ID := '00000000'
0066    REINPUT 'OK - DONE'
0067    
0068END-DECIDE
0069END
