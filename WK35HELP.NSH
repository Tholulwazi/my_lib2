0023    MOVE 'DIVORSED' TO #M-DESCR
0024  WHEN #SELECT(4)  = 'X'
0025    MOVE 'M'  TO #MARITAL
0026    MOVE 'MARRIED' TO #M-DESCR
0027  WHEN NONE
