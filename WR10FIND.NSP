0004/* FIND ALL EMPLOYEES THAT WORK IN SALES DEPART 
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DATA VIEW OF EMPLOYEES
0007  2 PERSONEL-ID (A8) /* CNNNNNNN
0008  2 NAME (A20) /* SURNAME/FAMILY NAME
0009  2 GENDER (A1) /* MALE /FEMALE
0010  2 DEPARTMENT (A4) /* MAINDEPT. CODE DDDD
0011  2 COUNTRY (A3) /* COUNTRY CODE
0012  2 DEPT (A6) /* DDDDSS
0013END-DEFINE
0014FORMAT LS= 100 
0015* FIND EMPLOYEES-DATA WITH EMPLOYEES-DATA.DEPT = 'SALE20'
0016 READ EMPLOYEES-DATA BY EMPLOYEES-DATA.DEPT = 'SALE20'
0017  DISPLAY
0018    *ISN
0019    EMPLOYEES-DATA.PERSONEL-ID
0020    EMPLOYEES-DATA.NAME (AL =10)
0021    EMPLOYEES-DATA.DEPT /** NOT  A SUBDESCRIPTOR
0022    EMPLOYEES-DATA.COUNTRY
0023
0024END
