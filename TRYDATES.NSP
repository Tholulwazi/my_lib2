00101 #DATE (A18)
0011END-DEFINE
0012
0013#DATE := '19022111' 
0014MOVE EDITED #DATE TO #DATE-1 (EM=YYYYDDMM)
0015
0016WRITE 'DATE-1 : ' #DATE-1 (EM=YYYY/DD/MM)
0017ADD 31 TO #DATE-1
0018WRITE 'Added 31 days : '#DATE-1 (EM=YYYY/DD/MM)
0019
0020#DATE := '19700101'
