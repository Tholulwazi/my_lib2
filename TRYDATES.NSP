0029
0030#DATE-4 := #DATE-3 - #DATE-2 
0031MULTIPLY #DATE-4 BY 0.36525 GIVING #DATE-4
0032WRITE 'Date 4 = date 2 -date 3' #DATE-4 /**(EM=YYYY/DD/MM)
0033END
