0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DATA VIEW OF EMPLOYEES
0007  2 PERSONEL-ID (A8) 
0008  2 COUNTRY (A3)
00091 #UPD-CONTRIES (N5)
00101 #TOTAL-REC (N5)
00111 #ET-COUNT (N5)
00121 #PROGRAM(A8)
0013END-DEFINE
0014#PROGRAM := *PROGRAM
0015DEFINE WORK FILE 1 'C:\Trainings\Old and New Country code list.txt'
0016
0017R1. READ EMPLOYEES-DATA BY PERSONEL-ID 
0018  ADD 1 TO #TOTAL-REC
0019
0020  DECIDE ON EVERY VALUE OF COUNTRY
0021    VALUE 'D' MOVE 'GER'   TO COUNTRY 
0022      ADD 1 TO #UPD-CONTRIES
0023    VALUE 'DK' MOVE 'DNK'  TO COUNTRY
0024      ADD 1 TO #UPD-CONTRIES
0025    VALUE 'F' MOVE 'FRA'   TO COUNTRY 
0026      ADD 1 TO #UPD-CONTRIES
0027    VALUE 'E' MOVE 'ESP'   TO COUNTRY  
0028      ADD 1 TO #UPD-CONTRIES
0029    ANY UPDATE
0030      ADD 1 TO #ET-COUNT
0031      IF #ET-COUNT = 50
0032        END TRANSACTION
0033        RESET #ET-COUNT
0034      END-IF
0035    NONE
0036      IGNORE /**'Country was not specified'
0037  END-DECIDE
0038END-READ (R1.)
0039/**END TRANSACTION
0040WRITE '*' 'Total RECORDS Read '#TOTAL-REC
0041WRITE '*' 'Total RECORDS Updated '#UPD-CONTRIES
0042WRITE '*' 'Total RECORDS ET-COUNT '#UPD-CONTRIES
0043END
