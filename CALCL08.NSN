0001/** New Subprogram CALCLT11.
0002/**
0003/** :author tzu
0004*
0005DEFINE DATA PARAMETER 
0006  1 #VALUE-1 (N4.4)
0007  1 #VALUE-2 (N4.4)
0008  1 #RESULT (N4.4)
0009  1 #OPERATOR (A1)
0010END-DEFINE
0011DECIDE ON FIRST VALUE OF #OPERATOR
0012    VALUE '-' 
0013    COMPUTE #RESULT := #VALUE-1 - #VALUE-2 
0014    VALUE '+' 
0015    COMPUTE #RESULT := #VALUE-1 + #VALUE-2 
0016    VALUE '*' 
0017    COMPUTE #RESULT := #VALUE-1 * #VALUE-2 
0018    VALUE '/' 
0019    COMPUTE #RESULT := #VALUE-1  / #VALUE-2  
0020    NONE 
0021   IGNORE
0022   
0023END-DECIDE
0024
0025 
0026END
