0005DEFINE DATA LOCAL
0006/** VEHICLES DATA
00071 VIHICLES-DATA VIEW OF VIHICLES
0008  2 PERSONEL-ID (A8)
0009  2 MAKE (A20)
0010  2 MODEL (A20)
0011  2 COLOUR (A10)
0012  2 YEAR (N4.0)
0013*
00141 EMPLOYEES-DATA VIEW OF EMPLOYEES
0015  2 PERSONEL-ID (A8) /* CNNNNNNN
0016  2 COUNTRY (A3) /* COUNTRY CODE
0017  2 FIRST-NAME (A20) /* FIRST / CHRISTIAN NAME
0018  2 NAME (A20) /* SURNAME / FAMILY NAME
0019  2 GENDER (A1) /* 
0020  2 CITY (A20) /* MAIN TOWN/CITY
0021  2 AREA-CODE (A6) /* PHONE NUMBER PREFIX
0022  2 PHONE (A15) /* PHONE (SELECT) NUMBER
0023*
0024END-DEFINE
0025FORMAT LS=200
0026
0027DEFINE WORK FILE 1
0028  'C:\trainings\RENAULT-GENDER-VEHICLES.csv'
0029  TYPE 'csv'
0030*
0031F1. FIND VIHICLES-DATA WITH VIHICLES-DATA.MAKE = 'RENAULT'
0032*
0033/** the point where the two meets is thru Personnel ID
0034  FIND EMPLOYEES-DATA WITH PERSONEL-ID = VIHICLES-DATA.PERSONEL-ID
0035    /** WHERE EMPLOYEES-DATA.GENDER = 'F'
0036*
0037*   IF NO RECORD FOUND
0038*     WRITE 'NO RECORD FOUND IN THE MENTIONED GENDER AND DEPARTMENT'
0039*     ESCAPE BOTTOM (F1.)
0040*   END-NOREC
0041*
0042    WRITE WORK 1
0043      EMPLOYEES-DATA.PERSONEL-ID
0044      EMPLOYEES-DATA.NAME
0045      EMPLOYEES-DATA.FIRST-NAME
0046      EMPLOYEES-DATA.GENDER
0047      EMPLOYEES-DATA.CITY
0048      EMPLOYEES-DATA.AREA-CODE
0049      EMPLOYEES-DATA.COUNTRY
0050      VIHICLES-DATA.MAKE
0051      VIHICLES-DATA.MODEL
0052      VIHICLES-DATA.COLOUR
0053      VIHICLES-DATA.YEAR
0054*
0055    AT END OF DATA
0056      WRITE ':' *NUMBER
0057        COUNT(F1.)(EMPLOYEES-DATA.NAME) (AD=I)
0058      WRITE 'EMPLOYEES WERE PRINTED TO THE WORKFILE'
0059    END-ENDDATA
0060  END-FIND
0061END-FIND
0062END
