0001/** New Program WRK49SCB.
0002/**
0003/** :author tzu
0004/* TODO Enter your code here
0005DEFINE DATA 
0006LOCAL
00071 #SCRAB-ALPH(A1/1:26) INIT
0008  <'A', 'B' , 'C' , 'D' ,'E', 'F', 'G','H',
0009  'I', 'J','K','L','M','N', 'O' ,'P','Q', 'R',
0010  'S','T','U', 'V' , 'W' , 'X', 'Y' ,'Z'>
00111 #SCRAB-POINTS(N2/1:26) INIT
0012  < 1, 3, 3, 2, 1, 4, 2, 4, 1, 8,
0013  5, 1, 3, 1, 1, 3, 10, 1, 1, 1, 1,
0014  4, 4, 8, 4, 10>
00151 #SCRAB-NAME (A26)
00161 REDEFINE #SCRAB-NAME
0017  2 #SCRAB(A1/1:26)
00181 #SCRABLE (A25)
00191 #TOTAL (N5)
00201 #TOTAL1 (N5)
00211 #TOTAL-REC (N5)
00221 #INDEX-INPUT (N10)
00231 #INDEX2 (N10)
00241 #WORD-LENGTH (N2)
00251 #START-TIME (A10)
00261 #END-TIME (A10)
00271 #HIGHEST (N2)
0028END-DEFINE
0029DEFINE WORK FILE 1 'C:\Trainings\Six letter word2.txt'
0030
0031DEFINE WORK FILE 2 'C:\Trainings\Scrabble  words with totals.txt'
0032
0033
0034
0035READ WORK FILE 1 #SCRABLE
0036  COMPUTE #START-TIME = *TIME
0037  ADD 1 TO #TOTAL-REC
0038  MOVE #SCRABLE TO #SCRAB-NAME
0039
0040  EXAMINE #SCRAB-NAME TRANSLATE INTO UPPER CASE
0041  EXAMINE #SCRAB-NAME FOR ' ' DELETE
0042/**
0043  RESET #TOTAL
0044
0045  FOR #INDEX-INPUT 1 TO 26
0046    IF #SCRAB(#INDEX-INPUT) = ' '
0047      ESCAPE BOTTOM
0048    END-IF
0049
0050    FOR #INDEX2 1 TO 26
0051
0052      IF #SCRAB(#INDEX-INPUT) = #SCRAB-ALPH(#INDEX2)
0053
0054      ADD #SCRAB-POINTS(#INDEX2) TO #TOTAL
0055        MOVE #TOTAL TO #TOTAL1
0056        WRITE WORK FILE 2 VARIABLE #SCRABLE/**#SCRAB-NAME   
0057        WRITE WORK FILE 2 VARIABLE'TOTAL POINTS :' #TOTAL1
0058        COMPUTE #END-TIME = *TIME
0059        ESCAPE BOTTOM
0060      END-IF
0061
0062    END-FOR
0063
0064  END-FOR
0065
0066  IF #HIGHEST < #TOTAL
0067    MOVE #TOTAL TO #HIGHEST
0068  END-IF
0069END-WORK
0070WRITE 'START TIME:' #START-TIME
0071WRITE 'END TIME  :' #END-TIME
0072WRITE 'HIGHEST TOTAL:' #HIGHEST
0073WRITE '*' 'TOTAL RECORDS PRINTED' #TOTAL-REC
0074END
