0005DEFINE DATA LOCAL
00061 TOP (N2)
00071 BOTM (N2)
00081 NUM (N2)
0009END-DEFINE
0010REPEAT
0011INPUT 'ENDER A NUMBER'NUM
0012/**
0013IF NUM NOT EQUAL TO 1
0014ADD 1 TO TOP
0015WRITE ' YOU ADDED 1 TO TOP'
0016ESCAPE TOP
0017END-IF
0018/**
0019IF NUM  >= 2
0020ADD 2 TO BOTM
0021WRITE ' YOU ADDED 2 TO BOTTOM'
0022ESCAPE BOTTOM
0023END-IF
0024END-REPEAT
0025END
