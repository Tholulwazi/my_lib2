0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DATA VIEW OF EMPLOYEES
0007  2 FIRST-NAME (A20) /* FIRST / CHRISTIAN NAME
0008  2 NAME (A20) /* SURNAME / FAMILY NAME
0009  2 PERSONEL-ID (A8) /* SURNAME / FAMILY NAME
0010  2 MAR-STAT (A20) /* M=MARRIED
0011  2 GENDER (A1)
0012  2 LANG (A3/1:5)
0013  2 ADDRESS-LINE (A20/1:2) /* ALL ADDRESS LINES
0014  2 CITY (A20) /* MAIN TOWN/CITY
0015  2 POST-CODE (A10) /* POSTAL ADDRESS CODE
0016  2 COUNTRY (A3) /* COUNTRY CODE
0017  2 DEPT (A6) /* DDDDSS
0018  2 JOB-TITLE (A25)
0019*****************************************************
00201 #FIRST-NAME (A20) /* FIRST / CHRISTIAN NAME
00211 #NAME (A20) /* SURNAME / FAMILY NAME
00221 #MAR-STAT (A20) /* M=MARRIED
00231 #GENDER (A1)
00241 #ADDRESS-LINE (A20/1:2) /* ALL ADDRESS LINES
00251 #CITY (A20) /* MAIN TOWN/CITY
00261 #POST-CODE (A10) /* POSTAL ADDRESS CODE
00271 #COUNTRY (A3) /* COUNTRY CODE
00281 #DEPT (A6) /* DDDDSS
00291 #JOB-TITLE (A25)
00301 #INDEX (N5)
00311 #PROGRAM (A8)
00321 #PERSONNEL-ID (N8)
00331  #LANG (A3/1:5)
0034END-DEFINE
0035SET CONTROL 'MT'
0036SET KEY
0037  PF3 NAMED 'Exit'
0038  ENTR NAMED 'Entr'
0039#PROGRAM := *PROGRAM
0040*   IF PERSONEL-ID IS (N8)
0041*     #PERSONNEL-ID:=VAL (PERSONEL-ID)
0042*   END-IF
0043R1. READ (1) EMPLOYEES-DATA IN DESCENDING SEQUENCE  BY PERSONEL-ID 
0044  UPDATE (R1.)
0045
0046  INPUT USING MAP "WK42-ADD"
0047/**
0048  DECIDE ON EVERY VALUE OF *PF-KEY
0049    VALUE 'PF3'
0050      ESCAPE MODULE
0051    VALUE 'ENTR'
0052      IGNORE
0053    VALUE 'PF8'
0054      ESCAPE BOTTOM
0055    NONE
0056      REINPUT 'Enter a valid key !!!'
0057  END-DECIDE
0058  /**
0059  IF #NAME EQ  ' '
0060    REINPUT 'Surname Can not be left Blank'
0061      MARK  *#NAME
0062  END-IF
0063/**
0064  IF #FIRST-NAME EQ ' '
0065    REINPUT 'First Name Can not be left Blank'
0066      MARK  *#FIRST-NAME
0067  END-IF
0068/**
0069
0070  IF #MAR-STAT EQ  ' ' 
0071    REINPUT 'Marital Status Is Required - Please enter (S,M,D OR W)'
0072      MARK  *#MAR-STAT
0073  END-IF
0074  /**
0075IF NOT (#MAR-STAT = 'S'  OR #MAR-STAT   = 'M' OR #MAR-STAT = 'D' OR #MAR-STAT = 'W')
0076REINPUT ' Please enter : ("S"-Single,"M"-Married,"D"-Divorsed OR "W"-Widowed)'
0077      MARK  *#MAR-STAT
0078
0079  END-IF
0080  /**
0081  IF #GENDER EQ ' '
0082    REINPUT 'Gender Is Required-Please Enter: "M" or "F" '
0083      MARK  *#GENDER
0084  END-IF
0085    /**
0086    IF NOT ( #GENDER EQ 'M' OR EQ 'F')
0087      REINPUT 'Please Enter: "M" or "F" '
0088        MARK  *#GENDER
0089  
0090  END-IF
0091  /**
0092  IF #ADDRESS-LINE(1) EQ  ' '
0093    REINPUT 'Adress Can not be left Blank-Please Enter Your Address'
0094      MARK  *#ADDRESS-LINE(1)
0095  END-IF
0096  /**
0097  IF #CITY EQ  ' '
0098    REINPUT 'City Can not be left Blank'
0099      MARK  *#CITY
0100  END-IF
0101  /**
0102  IF #POST-CODE EQ  ' '
0103    REINPUT 'Post-Code Can not be left Blank'
0104      MARK  *#POST-CODE
0105  END-IF
0106  /**
0107  IF #COUNTRY EQ  ' '
0108    REINPUT 'Country Can not be left Blank'
0109      MARK  *#COUNTRY
0110  END-IF
0111  /**
0112  IF #DEPT EQ  ' '
0113    REINPUT 'Department Can not be left Blank'
0114      MARK  *#DEPT
0115  END-IF
0116  /**
0117  IF #JOB-TITLE EQ  ' '
0118    REINPUT 'Job Title Can not be left Blank'
0119      MARK  *#JOB-TITLE
0120  END-IF
0121  /**
0122  IF #LANG(1) EQ  ' '
0123    REINPUT 'Atleast one Language should be filled '
0124      MARK *#LANG(1)
0125  END-IF
0126
0127  /**
0128  FIRST-NAME := #FIRST-NAME
0129  NAME := #NAME
0130  MAR-STAT := #MAR-STAT
0131  GENDER := #GENDER
0132  ADDRESS-LINE(*) := #ADDRESS-LINE(*)
0133  CITY  := #CITY
0134  POST-CODE := #POST-CODE
0135  COUNTRY  := #COUNTRY
0136  DEPT := #DEPT
0137  JOB-TITLE := #JOB-TITLE
0138  LANG (*) :=#LANG(*)
0139
0140 
0141  /**
0142  IF PERSONEL-ID IS (N8)
0143    #PERSONNEL-ID:=VAL (PERSONEL-ID)
0144  END-IF
0145  /**
0146 ADD 1 TO #PERSONNEL-ID
0147  INPUT USING MAP "PERSID"
0148      STORE RECORD IN EMPLOYEES-DATA
0149  END OF TRANSACTION 
0150END-READ (R1.)
0151
0152WRITE 'LAST PERSONEL ID'PERSONEL-ID
0153WRITE 'NEW PERSONEL ID'#PERSONNEL-ID
0154END
