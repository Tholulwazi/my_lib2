0005DEFINE DATA LOCAL
00061 EMPLOYEES-DATA VIEW OF EMPLOYEES
0007  2 PERSONEL-ID (A8) 
0008  2 COUNTRY (A3)
00091 #INDEX (N10)
00101 #NUMBER (A1)
00111 REDEFINE #NUMBER
00122 #NUMBER-N (N1)
00131 #COUNTRY (A3/1:9)
00141 #PROGRAM(A8)
0015END-DEFINE
0016#PROGRAM := *PROGRAM
0017
0018READ EMPLOYEES-DATA BY PERSONEL-ID 
0019
0020  #NUMBER := SUBSTRING(PERSONEL-ID,1,1)
0021  
0022      MOVE COUNTRY TO #COUNTRY(#NUMBER-N)
0023      
0024END-READ
0025FOR  #INDEX 1  TO 9
0026  IF #COUNTRY(#INDEX) NE ' '
0027    WRITE  #COUNTRY(#INDEX)
0028  END-IF
0029END-FOR
0030END
