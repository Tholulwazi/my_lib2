0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES-DATA VIEW OF EMPLOYEES
0008
0009  2 PERSONEL-ID (A8) /* CNNNNNNN
0010
0011  2 NAME (A20) /* SURNAME / FAMILY NAME
0012
0013  2 GENDER (A1)
0014
0015  2 DEPT (A6) /* DDDDSS
0016
0017*
0018END-DEFINE
0019SET CONTROL 'MT'
0020*
0021FORMAT LS= 200
0022
0023*
0024F1. FIND EMPLOYEES-DATA WITH EMPLOYEES-DATA.DEPARTMENT = 'SALE' 
0025*
0026    WHERE EMPLOYEES-DATA.GENDER = 'F'
0027*    
0028  IF NO RECORD FOUND
0029    WRITE 'NO RECORD FOUND IN THE MENTIONED GENDER AND DEPARTMENT'
0030    ESCAPE BOTTOM (F1.)
0031  END-NOREC
0032  DISPLAY
0033    *ISN
0034    'PERSONNEL ID'EMPLOYEES-DATA.PERSONEL-ID
0035    'NAME'EMPLOYEES-DATA.NAME (AL=10)
0036    'DEPARTMENT'EMPLOYEES-DATA.DEPT (AL=5)
0037    'GENDER'EMPLOYEES-DATA.GENDER (AL=1)
0038    'NO OF RECORDS'*NUMBER
0039    'TOTAL NO. EMPLOYEES'*COUNTER
0040  AT END OF DATA
0041    WRITE 'THIS ARE THE RECORDS FOUND'
0042      COUNT(F1.)(EMPLOYEES-DATA.GENDER) 
0043      WRITE 'IN SALES DEPARTMENT'
0044  END-ENDDATA
0045END-FIND
0046
0047END
