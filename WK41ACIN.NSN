0003/** :author tzu
0004DEFINE DATA PARAMETER
00051 #PERSONNEL-ID (A8)
00061 #NAME (A20)
0007LOCAL
00081 EMPLOYEES-DATA VIEW OF EMPLOYEES
0009  2 PERSONEL-ID (A8) /* CNNNNNNN
0010  2 NAME (A20) /* SURNAME / FAMILY NAME
0011  2 DEPT (A6) /* DDDDSS
0012  2 JOB-TITLE (A25)
0013    2 LEAVE-DUE (N2.0) /* VACATION DAYS/YEAR
0014    2 LEAVE-TAKEN (N2.0) /* VACATION DAYS TAKEN
0015******************************************************************
0016 2 CURR-CODE (A3/1:3)
0017 2 SALARY (P9.0 /1:3)
0018 2 BONUS (P9.0/1:3,1:3)
0019 2 LEAVE-START (N8.0/1:3)
0020 2 LEAVE-END (N8.0/1:3)
00211 #PROGRAM(A8)
0022******************************************************************
0023/*INDEX
00241 #INDEX (N3)
0025******************************************************************
0026END-DEFINE
0027#PROGRAM := *PROGRAM
0028FIND EMPLOYEES-DATA WITH PERSONEL-ID = #PERSONNEL-ID
0029INPUT USING MAP "WRK41-13"
0030END-FIND
0031END
