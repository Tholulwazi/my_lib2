0001/** New Program WR13WORK.
0002/**Workshop 13 – READ work file
0003/** :author tzu
0004/* 
0005DEFINE DATA LOCAL
00061 #AFRICAN-COUNTRIES (A100) 
00071 #NUMBER (A5)
00081 #COUNTRY-NAME (A30)
00091 #POPULATION (A15)
00101 #REGION-IN-AFRICA (A20)
0011END-DEFINE
0012*
0013FORMAT LS=200 /** CONTROL THE PAGE SIZE FOR DISPLAY
0014DEFINE WORK FILE 2
0015  'C:\TRAININGS\AFR-COUNTRIES.TXT'
0016READ WORK FILE 2 #AFRICAN-COUNTRIES
0017
0018SEPARATE  #AFRICAN-COUNTRIES INTO
0019#NUMBER 
0020#COUNTRY-NAME 
0021#POPULATION
0022 #REGION-IN-AFRICA
0023WITH DELIMITER '#' 
0024*
0025EXAMINE #POPULATION FOR ',' DELETE /** TO REMOVE THE COMMAS
0026*
0027MOVE RIGHT #POPULATION TO #POPULATION
0028*
0029DISPLAY #NUMBER (AL=2) 
0030#COUNTRY-NAME (AL=15)
0031#POPULATION(AL=15) 
0032#REGION-IN-AFRICA (AL=15)
0033*
0034 AT END OF DATA
0035 WRITE 'RECORDS WERE PRINTED TO THE WORKFILE :'
0036      COUNT(#AFRICAN-COUNTRIES) (AD=I)
0037
0038  END-ENDDATA
0039*
0040* WRITE WORK 2 #AFRICAN-COUNTRIES
0041END-WORK
0042CLOSE WORK FILE 2
0043END
0044
