0001/** New Subprogram WRK41ADD.
0002/**
0003/** :author tzu
0004DEFINE DATA PARAMETER
00051 #PERSONNEL-ID (A8)
0006LOCAL
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONEL-ID (A8) 
0009  2 NAME (A20) 
0010  2 ADDRESS-LINE (A20/1:2) 
0011  2 CITY (A20) 
0012  2 POST-CODE (A10) 
0013  2 COUNTRY (A3) 
0014  2 AREA-CODE (A6) 
0015  2 PHONE (A15) 
00161 #INDEX (N2)
00171 #SEL (A1/1:16)
00181 #ADDRESS-LINE(A20/1:2)
00191 #PROGRAM(A8)
0020END-DEFINE
0021FIND EMPLOYEES WITH PERSONEL-ID = #PERSONNEL-ID
0022PERSONEL-ID:= #PERSONNEL-ID
0023#ADDRESS-LINE(*) := ADDRESS-LINE(*)
0024INPUT USING MAP "WRK41-12"
0025END-FIND
0026END
