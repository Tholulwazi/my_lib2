0003/** :author tzu
0004/* TODO Enter your code here
0005DEFINE DATA 
0006LOCAL
00071 #SCRAB-ALPH(A1/1:26) INIT
0008  <'A', 'B' , 'C' , 'D' ,'E', 'F', 'G','H',
0009  'I', 'J','K','L','M','N', 'O' ,'P','Q', 'R',
0010  'S','T','U', 'V' , 'W' , 'X', 'Y' ,'Z'>
00111 #SCRAB-POINTS(N2/1:26) INIT
0012  < 1, 3, 3, 2, 1, 4, 2, 4, 1, 8,
0013  5, 1, 3, 1, 1, 3, 10, 1, 1, 1, 1,
0014  4, 4, 8, 4, 10>
00151 #SCRAB-NAME (A26)
00161 REDEFINE #SCRAB-NAME
0017  2 #SCRAB(A1/1:26)
00181 #TOTAL (N5)
00191 #INDEX-INPUT (N10)
00201 #INDEX2 (N10)
00211 #WORD-LENGTH (N2)
0022END-DEFINE
0023RESET #TOTAL
0024
0025INPUT 'Enter a Word' #SCRAB-NAME
0026EXAMINE #SCRAB-NAME TRANSLATE INTO UPPER CASE
0027 EXAMINE #SCRAB-NAME FOR ' ' DELETE
0028/**
0029FOR #INDEX-INPUT 1 TO 26 
0030  IF #SCRAB(#INDEX-INPUT) = ' '
0031    #WORD-LENGTH :=#INDEX-INPUT - 1
0032    ESCAPE BOTTOM
0033  END-IF
0034END-FOR
0035/***
0036FOR #INDEX-INPUT 1 TO 26
0037  IF #SCRAB(#INDEX-INPUT) = ' '
0038    ESCAPE BOTTOM
0039  END-IF
0040  FOR #INDEX2 1 TO 26
0041    IF #SCRAB(#INDEX-INPUT) = #SCRAB-ALPH(#INDEX2)
0042      ADD #SCRAB-POINTS(#INDEX2) TO #TOTAL
0043      ESCAPE BOTTOM
0044    END-IF
0045  END-FOR
0046END-FOR 
0047WRITE  'RESULTS'  3X /
0048  'Entered Word :'#SCRAB-NAME //
0049  'Name Length  :'#WORD-LENGTH //
0050  'Total Points :'#TOTAL  //
0051  '===============END==============='
0052
0053
0054END
