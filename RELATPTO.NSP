0005DEFINE DATA
0006LOCAL 
00071 SALARY
0008  2 #JOHN (N3)
0009  2 #MENLYN (N2)
0010  2 #JACOB (N4)
0011END-DEFINE
0012
0013#JOHN := 500 
0014#MENLYN :=70
0015#JACOB :=1000
0016
0017IF #JACOB LT #JOHN AND #MENLYN GT #JACOB
0018  WRITE  #JACOB' SALARY IS LESS THAN ' #JOHN
0019ELSE
0020  WRITE #JACOB ' SALARY IS GREATER THAN ' #JOHN
0021END-IF
0022
0023END
