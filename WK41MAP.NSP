0001/** New Program WK41MAP.
0002/** /*   MOVE #RESTART-NAME       TO   #RES-NAME (#INDEX)
0003/* MOVE #RES-NAME (#INDEX)      TO  #RESTART-NAME
0004/** :author tzu
0005/* TODO Enter your code her
0006DEFINE DATA
0007LOCAL
00081 EMPLOYEES-DATA VIEW OF EMPLOYEES
0009  2 PERSONEL-ID (A8) 
0010  2 NAME (A20) 
0011  2 CITY (A20) 
0012  2 GENDER (A1)
0013  2 MAR-STAT (A20) /* M=MARRIED
0014  2 ADDRESS-LINE (A20/1:2)
0015  2 AREA-CODE (A6) /* PHONE NUMBER PREFIX
0016  2 COUNTRY (A3) /* COUNTRY CODE
0017  2 PHONE (A15) /* PHONE (SELECT) NUMBER
0018  2 POST-CODE (A10)
0019/**
00201 #SEL (A1/1:16)
00211 #RESTART-NAME (A20)
00221 #LATE-RESTART-NAME (A20)
00231 #RES-NAME (A4/1:16)
00241 #CITY (A20/1:16)
00251 #NAME (A20/1:16)
00261 #PERSONNEL-ID (A8/1:16)
00271 #ADDRESS-LINE (A20/1:2)
00281 #INDEX (N10)
00291 #INDEX1 (N10)
00301 #INDEX2 (N10)
00311 #PROGRAM (A8)
00321 #RESTART-NAME2 (A20)
00331 #REPOS-FLAG (A1)
00341 #G-DESCRIPTION (A10)
00351 #S-DESCRIPTION (A10)
0036
0037END-DEFINE
0038SET CONTROL 'MT'
0039MOVE *PROGRAM TO #PROGRAM
0040
0041/**SETTING PF KEYS
0042SET KEY 
0043  PF1 = HELP
0044  PF3 NAMED 'Exit'
0045  PF8 NAMED 'Next'
0046/**
0047READ EMPLOYEES-DATA WITH REPOSITION
0048    BY NAME
0049    STARTING FROM #RESTART-NAME2
0050  ADD 1 TO #INDEX
0051/**MOVE THE VARIABLE USING PARSING THEIR INDEXES
0052  MOVE PERSONEL-ID TO    #PERSONNEL-ID (#INDEX)
0053  MOVE NAME        TO    #NAME(#INDEX)
0054  MOVE CITY        TO    #CITY(#INDEX)
0055  MOVE ADDRESS-LINE(1:2) TO  #ADDRESS-LINE (1:2)
0056/**
0057  IF #INDEX = 16
0058
0059    REPEAT
0060
0061      INPUT USING MAP "WK41MP"
0062
0063      DECIDE ON EVERY VALUE OF *PF-KEY
0064        VALUE 'PF3'
0065          ESCAPE MODULE
0066        VALUE 'ENTR'
0067          IGNORE
0068        VALUE 'PF8'
0069          ESCAPE BOTTOM
0070        NONE
0071          REINPUT 'Enter a valid key !!!'
0072      END-DECIDE
0073
0074      /**
0075      FOR #INDEX1 = 1 TO 16
0076        DECIDE ON EVERY VALUE OF #SEL(#INDEX1)
0077          VALUE 'A'
0078            CALLNAT "WRK41ADD" #PERSONNEL-ID (#INDEX1)
0079          VALUE 'V'
0080            CALLNAT "WK41-VEH" #PERSONNEL-ID (#INDEX1) #NAME (#INDEX1)
0081          VALUE 'C'
0082            CALLNAT "WK41ACIN" #PERSONNEL-ID(#INDEX1) #NAME(#INDEX1)
0083          VALUE 'P'
0084            CALLNAT "WK41APIN" #PERSONNEL-ID(#INDEX1) #NAME(#INDEX1)
0085              #S-DESCRIPTION #G-DESCRIPTION
0086          NONE
0087            IGNORE
0088        END-DECIDE
0089      END-FOR
0090      /**
0091
0092    /**
0093    DECIDE ON EVERY VALUE OF GENDER
0094      VALUE 'M' MOVE 'MALE' TO #G-DESCRIPTION
0095      VALUE 'F' MOVE 'FEMALE' TO #G-DESCRIPTION
0096      NONE MOVE 'NOT SPEC'  TO #G-DESCRIPTION
0097    END-DECIDE
0098    /**
0099    DECIDE ON EVERY VALUE OF MAR-STAT
0100      VALUE 'S' MOVE 'SINGLE' TO  #S-DESCRIPTION
0101      VALUE 'M' MOVE 'MARRIED' TO  #S-DESCRIPTION
0102      VALUE 'D' MOVE 'DIVORSED' TO  #S-DESCRIPTION
0103      VALUE 'W' MOVE 'WIDOWED' TO  #S-DESCRIPTION
0104      NONE MOVE 'NOT SPEC' TO #S-DESCRIPTION
0105    END-DECIDE
0106      IF  #RESTART-NAME NE ' '
0107        MOVE #RESTART-NAME TO #LATE-RESTART-NAME #RESTART-NAME2
0108        RESET  #RESTART-NAME
0109        RESET #INDEX
0110        MOVE 'Y' TO #REPOS-FLAG
0111        ESCAPE BOTTOM
0112      END-IF
0113      /**
0114    END-REPEAT
0115    /**
0116    RESET #INDEX1
0117    IF #REPOS-FLAG = 'Y'
0118      RESET #REPOS-FLAG
0119      ESCAPE TOP REPOSITION
0120    END-IF
0121  END-IF
0122END-READ
0123
0124IF #INDEX LE 16
0125
0126  RESET
0127
0128    #CITY (#INDEX + 1:16)
0129
0130    #NAME (#INDEX + 1:16)
0131
0132    #PERSONNEL-ID (#INDEX + 1:16)
0133
0134    #SEL (#INDEX + 1:16)
0135
0136  INPUT MARK *#RESTART-NAME
0137
0138    USING MAP "WK41MP"
0139
0140END-IF
0141END
0142
0143
0144/**junks
0145*       IF  #RESTART-NAME NE ' '
0146*         MOVE #RESTART-NAME TO #LATE-RESTART-NAME #RESTART-NAME2
0147*         RESET  #RESTART-NAME
0148*         RESET #INDEX
0149*         MOVE 'Y' TO #REPOS-FLAG
0150*        ESCAPE TOP REPOSITION
0151*      END-IF
0152*     RESET #INDEX
0153/**
0154*     IF *PF-KEY = 'PF3'
0155*       ESCAPE BOTTOM
0156*       RESET #INDEX
0157*     END-IF
0158/**
0159* 
0160*   RESET #SEL(#INDEX1)
0161*     END-IF
0162/**
0163*     IF  #RESTART-NAME NE ' '
0164*       MOVE #RESTART-NAME TO #LATE-RESTART-NAME #RESTART-NAME2
0165*       RESET  #RESTART-NAME
0166*       RESET #INDEX
0167*       MOVE 'Y' TO #REPOS-FLAG
0168*     END-IF
0169*   END-REPEAT
0170*   
0171*   RESET #INDEX1
0172*   IF #REPOS-FLAG = 'Y'
0173*     RESET #REPOS-FLAG
0174*     ESCAPE TOP REPOSITION
0175*  END-IF
