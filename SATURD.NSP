0001** Example 'DECEX1': DECIDE FOR (with FIRST option)                     
0002************************************************************************
0003* DEFINE DATA LOCAL                                                       
0004* 1 #FUNCTION (A1)                                                        
0005* 1 #PARM     (A1)                                                        
0006* END-DEFINE                                                              
0007* *                                                                       
0008* INPUT #FUNCTION #PARM                                                   
0009* *                        
0010* SET CONTROL 'MT'                                               
0011* DECIDE FOR FIRST CONDITION                                              
0012*   WHEN #FUNCTION = 'A' AND #PARM = 'X'                                  
0013*     WRITE 'FUNCTION A WITH PARAMETER X SELECTED.'                       
0014*   WHEN #FUNCTION = 'B' AND #PARM = 'X'                                  
0015*     WRITE 'FUNCTION B WITH PARAMETER X SELECTED.'                       
0016*   WHEN #FUNCTION = 'C' THRU 'D'                                         
0017*     WRITE 'FUNCTION C OR D SELECTED.'                                   
0018*   WHEN NONE                                                             
0019*     REINPUT 'PLEASE ENTER A VALID FUNCTION.'                            
0020*             MARK *#FUNCTION 
0021* END-DECIDE
0022* *         
0023* END
0024
0025DEFINE DATA LOCAL
0026* 01 EMPOYEES
0027*   02 #NAMES (A20)
002801 #NUMBERS (N2)
0029END-DEFINE
0030SET CONTROL 'MT'
0031*  INPUT 'ENTER NAME ' #NAMES / 'ENTER AGE'  #NUMBERS
0032* DECIDE FOR EVERY CONDITION 
0033*   WHEN #NAMES = 'HELLO' OR #NUMBERS = 0
0034*     WRITE 'HELLO & 0'
0035*   WHEN #NAMES = ' '  OR #NUMBERS < 0
0036*     WRITE 'THIS PLACE CANNOT BE LEFT BLANK OR < 0'
0037*   WHEN NONE
0038*     WRITE 'INVALID STATEMENT'
0039* END-DECIDE
0040INPUT 'ENTER A VALUE 0 -20' / #NUMBERS 
0041IF #NUMBERS = 99
0042  STOP
0043END-IF
0044DECIDE ON EVERY VALUE OF #NUMBERS
0045  VALUE  1:3
0046    WRITE ' VALUE ENTERED IS 1 OR 2 OR 3'
0047  VALUE 5
0048    WRITE 'YOU ENTERED 5'
0049  VALUE 7:9
0050    WRITE 'VALUE ENTERED IS 7 OR 8 OR 9 '
0051  VALUE 10:15
0052    WRITE 'THE VALUE IS IN A RANGE OF 10 TO 15'
0053  VALUE 16:20
0054    WRITE 'THE VALUE IS IN THE RANGE OF 15 TO 20'
0055  NONE
0056    WRITE 'YOU ENTERED A INVALID VALUE'
0057END-DECIDE
0058
0059END
